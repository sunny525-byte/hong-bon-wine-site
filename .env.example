# Copy to .env for local work.  .env is gitignored; this file is committed so a
# fresh clone shows what the project needs.
#
# In production this is set in Netlify → Site configuration → Environment
# variables (scope: Functions) and is what the admin gate actually reads.
# You only need it locally to exercise the password gate — e.g. via `netlify dev`.
# Never commit a real value here.
PROTECTED_PAGE_PASSWORD=
